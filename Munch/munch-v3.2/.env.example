# ---------------------------------------------------------------------------
# munch. environment
# Copy to .env.local for local dev. Never commit real values.
# ---------------------------------------------------------------------------

# --- Browser (Vite inlines every VITE_ value) -------------------------------
# Only publishable keys may live here. Power the real Clerk sign-in when set.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
# Base URL of the Munch API (server/munch-api.ts). Leave empty to use the
# scoped localStorage cache and the clearly-labelled demo identity.
VITE_MUNCH_API_URL=

# --- Server / Neon Function only — never prefix these with VITE_ -----------
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
CLERK_SECRET_KEY=sk_test_your_secret_key
# Comma-separated exact origins allowed to call the API with a token.
APP_ORIGIN=http://localhost:5173
# Public app URL used in invite emails.
APP_URL=http://localhost:5173

# --- Resend (email invites) -------------------------------------------------
# Server-only. The sending domain must be verified in the Resend dashboard.
RESEND_API_KEY=re_your_api_key
RESEND_FROM=munch. <hello@your-verified-domain.com>

# Pull real database values with: neon env pull
NEON_BRANCH=production

# --- Real restaurant photos (optional) --------------------------------------
# Without these the app shows clearly-labelled "Sample photo" imagery, plus real
# photos wherever OpenStreetMap contributors tagged one (free).
# Browser flag: set to 1 only when the API below has a photo key.
VITE_MUNCH_REAL_PHOTOS=
# Server-only. Google Places API (New) key with Places API enabled; billed per call.
GOOGLE_PLACES_API_KEY=
# Max photo lookups per server instance per day (default 300). Also set a quota/budget in Google Cloud.
PHOTO_DAILY_CAP=300
